    {
        %(op_decl)s
        %(op_rd)s

        const uint32_t rows = mlen / rlen;
        const uint32_t cols = rlen / 32;

        for (int row = 0; row < rows; row++) {
            for(int col = 0; col < cols; col++) {
                %(code)s;
            }
        }

        if (traceData)
            cmd.set(traceData->csiData);

        %(op_wb)s
        return NoFault;
    }
}};

