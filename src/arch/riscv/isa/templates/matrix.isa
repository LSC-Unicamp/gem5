def template MatrixArithMicroConstructor {{

%(class_name)s::%(class_name)s(ExtMachInst _machInst, uint32_t _microIdx,
                               uint32_t _microml)
  : %(base_class)s(
        "%(mnemonic)s", _machInst, %(op_class)s, _microIdx, _microml)
{
    %(set_reg_idx_arr)s;
    _numSrcRegs = 0;
    _numDestRegs = 0;
    setDestRegIdx(_numDestRegs++, matRegClass[_machInst.mrd]);
    _numTypedDestRegs[MatRegClass]++;
    setSrcRegIdx(_numSrcRegs++, matRegClass[_machInst.mrs1]);
    setSrcRegIdx(_numSrcRegs++, matRegClass[_machInst.mrs2]);
}

}};


def template MatrixArithLineMicroConstructor {{

%(class_name)s::%(class_name)s(ExtMachInst _machInst, uint32_t _microIdx,
                               uint32_t _microml)
  : %(base_class)s(
        "%(mnemonic)s", _machInst, %(op_class)s, _microIdx, _microml)
{
    %(set_reg_idx_arr)s;
    _numSrcRegs = 0;
    _numDestRegs = 0;
    setDestRegIdx(_numDestRegs++, matRegClass[_machInst.mrd]);
    _numTypedDestRegs[MatRegClass]++;
    setSrcRegIdx(_numSrcRegs++, matRegClass[_machInst.mrs1]);
    setSrcRegIdx(_numSrcRegs++, matRegClass[_machInst.mrs2]);
    setSrcRegIdx(_numSrcRegs++, matRegClass[_machInst.mrs3]);

    cmd.opcode = MatrixCmd::Opcode::MMACU;
}

}};


def template MatrixArithMicroExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        %(op_decl)s;
        %(op_rd)s;
        %(set_rlenb)s;

        uint32_t i = microIdx;

        %(code)s;

        %(op_wb)s;
        return NoFault;
    }
}};


def template MatrixMoveMicroExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        %(op_decl)s;
        %(op_rd)s;
        %(set_rlenb)s;

        uint32_t msew = 32;
        uint32_t rows = rlenb / (msew / 8);
        uint32_t i = microIdx;
        for (int row; row < rows; row++) {
            int consumed = rows;
            for(int k = 0; k < consumed; k++) {
                %(code)s;
                i++;
            }
        }

        if (microIdx == 0)
            cmd.print();

        %(op_wb)s;
        return NoFault;
    }
}};

def template MatrixArithLineMicroExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        %(op_decl)s
        %(op_rd)s
        %(set_rlenb)s

        for (int row; row < 4; row++) {
            for(int col = 0; col < 4; col++) {
                float acc = Mrs3->as<float>()[row * 4 + col];

                for (int j = 0; j < 4; j++) {
                    acc = (double) (Mrs1->as<float>()[row * 4 + j] * Mrs2->as<float>()[col * 4 + j]) + (double) acc;
                }

                Mrd[row * 4 + col] = acc;
            }
        }

        if (microIdx == 0)
            cmd.print();

        %(op_wb)s
        return NoFault;
    }
}};

