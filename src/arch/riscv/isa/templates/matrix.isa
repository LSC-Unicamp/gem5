    {
        return NoFault;
    }
}};

def template MatrixDecode {{
    return new %(class_name)s(machInst);
}};

def template MatrixArithDecode {{
    return new %(class_name)s(machInst, rlen);
}};

def template MatrixLoadConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst _machInst)
        : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s)
    {
        %(set_reg_idx_arr)s;
        %(constructor)s;

        StaticInstPtr microop;
        
        // TODO: Calculate total number of microops
        for (uint32_t i = 0; i < 64; i++) {
            microop = new %(class_name)sMicro(_machInst, i);
            microop->setDelayedCommit();
            microop->setFlag(IsLoad);
            this->microops.push_back(microop);
        }

        this->microops.front()->setFirstMicroop();
        this->microops.back()->setLastMicroop();
    }
}};

