def template MatrixMacroDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      private:
        %(reg_idx_arr_decl)s;
    
      public:
        %(class_name)s(ExtMachInst _machInst);
        %(class_name)s(ExtMachInst _machInst, uint64_t _rlen, uint64_t _mlen);
        using %(base_class)s::generateDisassembly;
    };
}};


def template MatrixMacroSplitConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst _machInst, uint64_t _rlen, uint64_t _mlen)
        : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s, _rlen, _mlen)
    {
        %(set_reg_idx_arr)s;
        %(constructor)s;

        StaticInstPtr microop;
        
        const uint32_t rows = mlen / rlen;

        for (uint32_t i = 0; i < rows; i++) {
            microop = new %(class_name)sMicro(_machInst, i, rlen, mlen);
            this->microops.push_back(microop);
        }

        this->microops.front()->setFirstMicroop();
        this->microops.back()->setLastMicroop();
    }
}};


def template MatrixMacroConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst _machInst, uint64_t _rlen, uint64_t _mlen)
        : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s, _rlen, _mlen)
    {
        %(set_reg_idx_arr)s;
        %(constructor)s;

        StaticInstPtr microop;

        microop = new %(class_name)sMicro(_machInst, 0, rlen, mlen);
        this->microops.push_back(microop);

        this->microops.front()->setFirstMicroop();
        this->microops.back()->setLastMicroop();
    }
}};


