def template MatrixLoadMicroExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Addr EA;

        %(op_decl)s;
        %(op_rd)s;
        %(set_rlenb)s;

        if (microIdx == 0)
            cmd.print();

        %(op_wb)s;
        return NoFault;
    }
}};

// TODO: Update this Execute definition
def template MatrixStridedLoadMicroExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Addr EA;

        %(op_decl)s;
        %(op_rd)s;
        %(set_rlenb)s;

        // for loop replaces the microIdx
        for (uint32_t i = 0; i < 4; i++) {
            // TODO: Get Address from decoder.isa
            %(ea_code)s

            const size_t mem_size = 4 * 4;
            std::vector<bool> byte_enable(mem_size, true);
            Fault fault = xc->readMem(EA, Mem.as<uint8_t>(), mem_size, 
                                          memAccessFlags, byte_enable);

            if (fault != NoFault)
                return fault;
            
            // % (code)s // Move code to decoder.isa
            for (int k = 0; k < 4; k++) {
                %(code)s
            }
        }

        %(op_wb)s;
        return NoFault;
    }
}};

def template MatrixStoreMicroExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Addr EA;

        %(op_decl)s;
        %(op_rd)s;
        %(set_rlenb)s;
        
        return NoFault;
    }
}};

def template MatrixStridedStoreMicroExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Addr EA;

        %(op_decl)s;
        %(op_rd)s;
        %(set_rlenb)s;

        for (uint32_t i = 0; i < 4; i++) {
            %(ea_code)s

            const size_t mem_size = 4 * 4;
            std::vector<bool> byte_enable(mem_size, true);

            for (int k = 0; k < 4; k++) {
                Mem.as<uint32_t>()[k] = Mrs3[k + i * 4];
            }

            Fault fault = xc->writeMem((uint8_t*) &Mem, mem_size, EA, memAccessFlags,
                                    nullptr, byte_enable);
            if (fault != NoFault)
                return fault;
        }
        return NoFault;
    }
}};

def template MatrixLoadMicroInitiateAcc{{
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Addr EA;
        %(op_decl)s;
        %(op_rd)s;
        %(set_rlenb)s;

        %(ea_code)s;

        // Since there are no microops, gets 16 contiguous positions
        const size_t mem_size = 16 * 4;
        std::vector<bool> byte_enable(mem_size, true);

        Fault fault = initiateMemRead(xc, EA, mem_size, memAccessFlags,
                                byte_enable);
        
        if (microIdx == 0)
            cmd.print(Rs1);

        return NoFault;
    }
}};

def template MatrixLoadMicroCompleteAcc{{
    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        %(op_decl)s;
        %(op_rd)s;
        %(set_rlenb)s;

        memcpy(Mem.as<uint8_t>(), pkt->getPtr<uint8_t>(), pkt->getSize());
        
        for (int k = 0; k < 16; k++) {
            Mrd[k] = Mem.as<uint32_t>()[k];
        }

        %(op_wb)s;
        return NoFault;
    }
}};

def template MatrixStoreMicroInitiateAcc{{
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Addr EA;

        %(op_decl)s;
        %(op_rd)s;
        %(set_rlenb)s;

        %(ea_code)s;

        // TODO: Get 16 from rlen
        const size_t mem_size = 16 * 4;
        std::vector<bool> byte_enable(mem_size, true);

        // TODO: Get 16 from rlen
        // TODO: Use memcpy
        for (int k = 0; k < 16; k++) {
            %(code)s;
        }

        if (microIdx == 0)
            cmd.print(Rs1);

        Fault fault = xc->writeMem((uint8_t*) &Mem, mem_size, EA, memAccessFlags,
                                nullptr, byte_enable);
        return fault;
    }
}};

def template MatrixStridedStoreMicroInitiateAcc{{
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Addr EA;

        %(op_decl)s;
        %(op_rd)s;
        %(set_rlenb)s;

        uint32_t i = microIdx;

        EA = Rs1 + i * Rs2;

        const size_t mem_size = 4 * 4;
        std::vector<bool> byte_enable(mem_size, true);

        for (int k = 0; k < 16; k++) {
            Mrd[k] = Mrs3[k];
        }

        for (int k = 0; k < 4; k++) {
            Mem.as<uint32_t>()[k] = Mrs3[i * 4 + k];
        }

        Fault fault = xc->writeMem((uint8_t*) &Mem, mem_size, EA, memAccessFlags,
                                nullptr, byte_enable);
        return fault;
    }
}};

def template MatrixStridedLoadMicroInitiateAcc{{
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Addr EA;
        %(op_decl)s;
        %(op_rd)s;
        %(set_rlenb)s;

        uint32_t i = microIdx;

        %(ea_code)s

        const size_t mem_size = 4 * 4;
        std::vector<bool> byte_enable(mem_size, true);

        Fault fault = initiateMemRead(xc, EA, mem_size, memAccessFlags,
                                byte_enable);
        return fault;
    }
}};

def template MatrixStridedLoadMicroCompleteAcc{{
    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        %(op_decl)s
        %(op_rd)s
        %(set_rlenb)s

        uint32_t i = microIdx;

        const size_t mem_size = 4 * 4;
        std::vector<bool> byte_enable(mem_size, true);

        memcpy(Mem.as<uint8_t>(), pkt->getPtr<uint8_t>(), pkt->getSize());
        
        // Copy Mrs3 data to Mrd
        for (int j = 0; j < 4; j++) {
            for (int k = 0; k < 4; k++) {
                %(cp_code)s
            }
        }

        for (int k = 0; k < 4; k++) {
            %(code)s
        }

        if (microIdx == 0)
            cmd.print(Rs1, Rs2);

        %(op_wb)s
        return NoFault;
    }
}};

