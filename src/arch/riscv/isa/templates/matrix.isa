def template MatrixLoadMicroExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Addr EA;
        %(op_decl)s
        %(op_rd)s
        
        %(ea_code)s

        const uint32_t rows = mlen / rlen;
        const uint32_t cols = rlen / 32;

        const size_t mem_size = rows * cols * 4;
        std::vector<bool> byte_enable(mem_size, true);

        Fault fault = xc->readMem(EA, Mem.as<uint8_t>(), mem_size, memAccessFlags,
                                byte_enable);

        if (fault != NoFault)
            return fault;
        
        for (int k = 0; k < (cols * rows); k++) {
            %(code)s
        }
        
        if (traceData)
            cmd.set(traceData->csiData, Rs1);
        
        %(op_wb)s
        return NoFault;
    }
}};

def template MatrixStridedLoadMicroExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Addr EA;
        %(op_decl)s;
        %(op_rd)s;

        const uint32_t rows = mlen / rlen;
        const uint32_t cols = rlen / 32;

        for (uint32_t i = 0; i < rows; i++) {
            %(ea_code)s

            const size_t mem_size = cols * 4;
            std::vector<bool> byte_enable(mem_size, true);
            Fault fault = xc->readMem(EA, Mem.as<uint8_t>(), mem_size, 
                                          memAccessFlags, byte_enable);

            if (fault != NoFault)
                return fault;
            
            for (int k = 0; k < cols; k++) {
                %(code)s
            }
        }

        if (traceData)
            cmd.set(traceData->csiData, Rs1, Rs2);

        %(op_wb)s;
        return NoFault;
    }
}};

def template MatrixStoreMicroExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Addr EA;
        %(op_decl)s
        %(op_rd)s

        %(ea_code)s
        
        const uint32_t rows = mlen / rlen;
        const uint32_t cols = rlen / 32;

        const size_t mem_size = cols * rows * 4;
        std::vector<bool> byte_enable(mem_size, true);

        for (int k = 0; k < (cols * rows); k++) {
            %(code)s
        }

        Fault fault = xc->writeMem(Mem.as<uint8_t>(), mem_size, EA, memAccessFlags,
                                nullptr, byte_enable);

        if (traceData)
            cmd.set(traceData->csiData, Rs1);

        return fault;
    }
}};

def template MatrixStridedStoreMicroExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        [[maybe_unused]] Addr EA;

        %(op_decl)s;
        %(op_rd)s;

        const uint32_t rows = mlen / rlen;
        const uint32_t cols = rlen / 32;

        for (uint32_t i = 0; i < rows; i++) {
            %(ea_code)s

            const size_t mem_size = cols * 4;
            std::vector<bool> byte_enable(mem_size, true);

            for (int k = 0; k < cols; k++) {
                Mem.as<uint32_t>()[k] = Mrs3[k + i * 4];
            }

            Fault fault = xc->writeMem((uint8_t*) &Mem, mem_size, EA, memAccessFlags,
                                    nullptr, byte_enable);
            if (fault != NoFault)
                return fault;
        }

        if (traceData)
            cmd.set(traceData->csiData, Rs1, Rs2);

        return NoFault;
    }
}};

def template MatrixLoadMicroInitiateAcc{{
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Addr EA;
        %(op_decl)s;
        %(op_rd)s;
        
        %(ea_code)s;

        const uint32_t rows = mlen / rlen;
        const uint32_t cols = rlen / 32;

        const size_t mem_size = rows * cols * 4;
        std::vector<bool> byte_enable(mem_size, true);

        Fault fault = initiateMemRead(xc, EA, mem_size, memAccessFlags,
                                byte_enable);
        
        if (fault != NoFault)
            return fault;

        if (traceData)
            cmd.set(traceData->csiData, Rs1);

        DPRINTF(MatRegs, "0x%x: %llu: initiateAcc :%s \n", 
            xc->tcBase()->pcState().instAddr(), 
            xc->tcBase()->getCpuPtr()->curCycle(), 
            generateDisassembly(0, nullptr)
        );
        return NoFault;
    }
}};

def template MatrixLoadMicroCompleteAcc{{
    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        %(op_decl)s
        %(op_rd)s
        
        const uint32_t rows = mlen / rlen;
        const uint32_t cols = rlen / 32;

        memcpy(Mem.as<uint8_t>(), pkt->getPtr<uint8_t>(), pkt->getSize());
        
        for (int k = 0; k < (cols * rows); k++) {
            %(code)s
        }

        DPRINTF(MatRegs, "0x%x: %llu: completeAcc :%s \n", 
            xc->tcBase()->pcState().instAddr(), 
            xc->tcBase()->getCpuPtr()->curCycle(), 
            generateDisassembly(0, nullptr)
        );

        %(op_wb)s
        return NoFault;
    }
}};

def template MatrixStoreMicroInitiateAcc{{
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Addr EA;
        %(op_decl)s
        %(op_rd)s

        %(ea_code)s
        
        const uint32_t rows = mlen / rlen;
        const uint32_t cols = rlen / 32;

        const size_t mem_size = cols * rows * 4;
        std::vector<bool> byte_enable(mem_size, true);

        for (int k = 0; k < (cols * rows); k++) {
            %(code)s;
        }

        Fault fault = xc->writeMem((uint8_t*) &Mem, mem_size, EA, memAccessFlags,
                                nullptr, byte_enable);

        if (fault != NoFault)
            return fault;

        if (traceData)
            cmd.set(traceData->csiData, Rs1);

        return fault;
    }
}};

def template MatrixStridedStoreMicroInitiateAcc{{
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Addr EA;

        %(op_decl)s
        %(op_rd)s
        
        const uint32_t rows = mlen / rlen;
        const uint32_t cols = rlen / 32;
        uint32_t i = microIdx;

        %(ea_code)s

        const size_t mem_size = cols * 4;
        std::vector<bool> byte_enable(mem_size, true);

        for (int k = 0; k < (cols * rows); k++) {
            // Copy input to output
            Mrd[k] = Mrs3[k];
        }

        for (int k = 0; k < cols; k++) {
            // Copy to memory
            // TODO: Dá pra reusar o % (code)s, mas forçar i = zero no de cima
            Mem.as<uint32_t>()[k] = Mrs3[i * 4 + k];
        }

        if (traceData)
            cmd.set(traceData->csiData, Rs1, Rs2);
            

        Fault fault = xc->writeMem((uint8_t*) &Mem, mem_size, EA, memAccessFlags,
                                nullptr, byte_enable);
        return fault;
    }
}};

def template MatrixStridedLoadMicroInitiateAcc{{
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        [[maybe_unused]] Addr EA;
        %(op_decl)s
        %(op_rd)s
        
        uint32_t i = microIdx;
        const uint32_t cols = rlen / 32;
        %(ea_code)s

        const size_t mem_size = cols * 4;
        std::vector<bool> byte_enable(mem_size, true);

        if (traceData)
            cmd.set(traceData->csiData, Rs1, Rs2);

        Fault fault = initiateMemRead(xc, EA, mem_size, memAccessFlags,
                                byte_enable);
        return fault;
    }
}};

def template MatrixStridedLoadMicroCompleteAcc{{
    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        %(op_decl)s
        %(op_rd)s

        uint32_t i = microIdx;
        const uint32_t rows = mlen / rlen;
        const uint32_t cols = rlen / 32;

        const size_t mem_size = cols * 4;
        std::vector<bool> byte_enable(mem_size, true);

        memcpy(Mem.as<uint8_t>(), pkt->getPtr<uint8_t>(), pkt->getSize());
        
        // Copy Mrs3 data to Mrd
        for (int j = 0; j < rows; j++) {
            for (int k = 0; k < cols; k++) {
                %(cp_code)s
            }
        }

        for (int k = 0; k < cols; k++) {
            %(code)s
        }

        %(op_wb)s
        return NoFault;
    }
}};

def template MatrixStoreMicroCompleteAcc{{
    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        %(op_decl)s
        %(op_rd)s

        if (traceData)
            cmd.set(traceData->csiData, Rs1);

        return NoFault;
    }
}};

def template MatrixStridedStoreMicroCompleteAcc{{
    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        %(op_decl)s
        %(op_rd)s

        if (traceData)
            cmd.set(traceData->csiData, Rs1, Rs2);

        return NoFault;
    }
}};

def template MatrixDecode {{
    return new %(class_name)s(machInst);
}};

def template MatrixRlenDecode {{
    return new %(class_name)s(machInst, rlen, mlen);
}};


def template MatrixLoadMicroConstructor {{

%(class_name)s::%(class_name)s(ExtMachInst _machInst, uint32_t _microIdx, uint64_t _rlen, uint64_t _mlen)
  : %(base_class)s(
        "%(mnemonic)s", _machInst, %(op_class)s, _microIdx, _rlen, _mlen)
{
    %(set_reg_idx_arr)s;
    _numSrcRegs = 0;
    _numDestRegs = 0;
    setDestRegIdx(_numDestRegs++, matRegClass[_machInst.mrd]);
    _numTypedDestRegs[MatRegClass]++;
    setSrcRegIdx(_numSrcRegs++, intRegClass[_machInst.rs1]);
    setSrcRegIdx(_numSrcRegs++, intRegClass[_machInst.rs2]);
    setSrcRegIdx(_numSrcRegs++, matRegClass[_machInst.mrs3]);

    cmd.opcode = (_machInst.nf << 5) | (_machInst.width);
    cmd.ms1 = MatrixCmd::Register::M0;
    cmd.ms2 = MatrixCmd::Register::M0;
    cmd.ms1sew = MatrixCmd::SEW::_1;
    cmd.ms2sew = MatrixCmd::SEW::_1;
}

}};


