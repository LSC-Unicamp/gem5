def template MatrixMacroDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      private:
        %(reg_idx_arr_decl)s;
    
      public:
        %(class_name)s(ExtMachInst _machInst);
        %(class_name)s(ExtMachInst _machInst, uint64_t _rlen, uint64_t _microml);
        using %(base_class)s::generateDisassembly;
    };
}};


def template MatrixMacroSplitConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst _machInst, uint64_t _rlen, uint64_t _microml)
        : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s, _rlen, _microml)
    {
        %(set_reg_idx_arr)s;
        %(constructor)s;

        StaticInstPtr microop;
        
        uint64_t lines = rlen / 32;
        uint64_t elem_width = 32;
        uint64_t columns = rlen / elem_width;
        uint64_t elems = lines * columns;

        for (uint32_t i = 0; i < 4; i++) {
            microop = new %(class_name)sMicro(_machInst, i, this->microMl);
            this->microops.push_back(microop);
        }

        this->microops.front()->setFirstMicroop();
        this->microops.back()->setLastMicroop();
    }
}};


def template MatrixMacroConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst _machInst, uint64_t _rlen, uint64_t _microml)
        : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s, _rlen, _microml)
    {
        %(set_reg_idx_arr)s;
        %(constructor)s;

        StaticInstPtr microop;

        microop = new %(class_name)sMicro(_machInst, 0, this->microMl);
        this->microops.push_back(microop);

        this->microops.front()->setFirstMicroop();
        this->microops.back()->setLastMicroop();
    }
}};


